//-----------------------------------------------------------------------------
//	BLOBULATOR.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		".."
$Macro OUTLIBDIR	"$SRCDIR\lib\common$PLATSUBDIR"

$include "$SRCDIR\vpc_scripts\source_lib_base.vpc"


$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions			"$BASE;BLOBULATOR_LIB"
		$AdditionalIncludeDirectories		"$BASE,$SRCDIR\game\client"
		$DisableSpecificWarnings			"$BASE;429" [$PS3]
		$ForceIncludes				"tier0\platform.h" [$WIN32||$POSIX]
	}
}

$Configuration "Release"
{
	$Compiler [$WIN32]
	{
		// TODO (ilya): I don't think buffer security check is necessary
		$BufferSecurityCheck				"Yes"
		// TODO (ilya): Should this be set to SSE instead of SSE2?
		$EnableEnhancedInstructionSet		"Streaming SIMD Extensions 2 (/arch:SSE2)"
	}

	$Compiler [$X360]
	{
		// TODO (ilya): I don't think buffer security check is necessary
		//$BufferSecurityCheck				"Yes"
	}
}

$Project "Blobulator"
{
	$Folder	"Util"
	{
		$File	"util\Constants.cpp"
		$File	"util\fasttrunc.cpp"
		$File	"util\rand.h"
	}

